# =================================================================
# UTDI MOBILE CARE & EMERGENCY SYSTEM - CONFIGURATION
# Universitas Teknologi Digital Indonesia (STMIK AKAKOM)
# =================================================================

# Server Port
PORT=5000

# =================================================================
# BIZNET GIO NEO OBJECT STORAGE (https://www.biznetgio.com)
# =================================================================
# Petunjuk Pengisian untuk Mahasiswa:
# 1. Buka https://portal.biznetgio.com dan login/daftar akun.
# 2. Masuk ke menu "Storage" -> "NEO Object Storage".
# 3. Buat Bucket baru (contoh: utdi-care-storage).
# 4. Buat Access Key & Secret Key pada menu "Access Keys".
# 5. Salin dan tempelkan data ke variabel di bawah ini:

# Endpoint Biznet GIO (Pilih sesuai region data center):
# - Jakarta (JKT-1): https://nos.jkt-1.neo.id
# - West Java / Cimanggis (WJV-1): https://nos.wjv-1.neo.id
BIZNET_GIO_ENDPOINT=https://nos.jkt-1.neo.id
BIZNET_GIO_REGION=jkt-1

# Kredensial Akun Biznet GIO Anda:
BIZNET_GIO_ACCESS_KEY=00d3e216103c97e72c51
BIZNET_GIO_SECRET_KEY=aPK3bPrZLa0m0KZqI18NWOA66NKmRwCdqnn3HN13

# Nama Bucket yang dibuat di portal Biznet GIO:
BIZNET_GIO_BUCKET=utdi-care-storage

# Catatan: Jika kredensial di atas belum diisi, sistem otomatis
# menggunakan Local Server Storage (/uploads/) sehingga aplikasi
# mobile tetap 100% berfungsi normal tanpa error!

